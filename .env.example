# Copy this file to ".env" and fill in your key.
# Get a free key at https://aistudio.google.com/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides (sane defaults already set in code)
GEMINI_MODEL=gemini-2.5-flash
PORT=8787

# Simple abuse protection for the /api/generate endpoint
RATE_LIMIT_PER_MIN=20

# ===== Post to X (Twitter) — OAuth 2.0 PKCE, user context =====
# Create an app at https://developer.x.com -> User authentication settings:
#   Type: Web App / Automated App or Bot   |   App permissions: Read and write
#   Callback URL must EXACTLY match X_CALLBACK_URL below.
X_CLIENT_ID=your_oauth2_client_id
X_CLIENT_SECRET=your_oauth2_client_secret
X_CALLBACK_URL=http://localhost:8787/api/x/callback
X_SCOPES=tweet.read tweet.write users.read offline.access

# Origin of the frontend (used as postMessage target after OAuth + for CORS if cross-origin)
FRONTEND_ORIGIN=http://localhost:5173

# 32-byte key (base64) for encrypting tokens at rest. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=

# MySQL connection for storing X tokens (encrypted at rest).
# NOTE: mysql2 (Node) uses the "mysql://" URI scheme, NOT Java's "jdbc:mysql://".
# Format: mysql://user:password@host:3306/database
# Local DB "MySql":
DATABASE_URL=mysql://root:YOUR_PASSWORD@localhost:3306/MySql
# If your local root has no password, use:  mysql://root@localhost:3306/MySql

# Set true when serving over HTTPS so the session cookie gets the Secure flag
COOKIE_SECURE=false
